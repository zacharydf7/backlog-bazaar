# ---------------------------------------------------------------------------
# Game data. Search walks a provider chain: IGDB -> RAWG -> Wikidata.
#
# IGDB (primary; richest data: covers, genres, platforms, ratings, developers).
# Uses Twitch app credentials, held SERVER-SIDE by the /api/igdb proxy — no
# VITE_ prefix, so they can never leak into the browser bundle. Register a
# (free) app at https://dev.twitch.tv/console/apps, then set these in the
# Vercel project env (they only take effect on deploys, like /api/hltb).
# ---------------------------------------------------------------------------
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# RAWG (optional standby). With a key, RAWG backs IGDB up; without any keys at
# all the app still searches via keyless Wikidata (titles + release years).
# Get a free key at https://rawg.io/apidocs (sign up -> "Get API Key").
# ---------------------------------------------------------------------------
VITE_RAWG_KEY=

# ---------------------------------------------------------------------------
# User accounts + sync + leaderboard (Supabase). Without these, the app runs
# locally with no login. Create a free project at https://supabase.com, then
# find these under Project Settings -> API.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
